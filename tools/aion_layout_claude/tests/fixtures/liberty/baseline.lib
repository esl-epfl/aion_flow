/*
 * Hand-written Liberty fixture: the PDK-standard-cell baseline.
 *
 * Same units, same 2x2 index grid and the same arithmetic-square tables as
 * candidate.lib, so any difference a comparison reports is a difference in the
 * cell and not in the way the file was written.  Three deliberate asymmetries:
 *
 *   - every table is 0.02 slower than the candidate's, so "faster" has one
 *     unambiguous answer;
 *   - the area is 19.9584 um2, the 5.28 x 3.78 um row three abutted PDK cells
 *     occupy, against the candidate's 10.8864;
 *   - there is NO I2 -> O0 arc.  The candidate has three arcs and this has two.
 *     A comparison that averages "the arcs both libraries have" silently drops
 *     the third; the contract is that it lands in `notes` instead.
 */
library (aion_baseline_typ) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1, pf);

  nom_voltage : 1.2;
  nom_temperature : 27.0;
  nom_process : 1.0;

  lu_table_template (del_2x2) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.0100, 0.1000");
    index_2 ("0.0010, 0.0100");
  }

  cell (AION_inv_nand2_nor2) {
    area : 19.9584;
    cell_leakage_power : 2.5000;

    pin (I0) {
      direction : input;
      capacitance : 0.0018;
    }
    pin (I1) {
      direction : input;
      capacitance : 0.0021;
    }
    pin (I2) {
      direction : input;
      capacitance : 0.0017;
    }
    pin (O0) {
      direction : output;
      function : "!((!I1 & I0) | I2)";
      max_capacitance : 0.0500;

      timing () {
        related_pin : "I0";
        timing_sense : negative_unate;
        cell_rise (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0400, 0.0600", \
                  "0.0800, 0.1000");
        }
        cell_fall (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0300, 0.0500", \
                  "0.0700, 0.0900");
        }
        rise_transition (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0350, 0.0550", \
                  "0.0750, 0.0950");
        }
        fall_transition (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0320, 0.0520", \
                  "0.0720, 0.0920");
        }
      }

      timing () {
        related_pin : "I1";
        timing_sense : positive_unate;
        cell_rise (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0500, 0.0700", \
                  "0.0900, 0.1100");
        }
        cell_fall (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0400, 0.0600", \
                  "0.0800, 0.1000");
        }
        rise_transition (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0360, 0.0560", \
                  "0.0760, 0.0960");
        }
        fall_transition (del_2x2) {
          index_1 ("0.0100, 0.1000");
          index_2 ("0.0010, 0.0100");
          values ("0.0330, 0.0530", \
                  "0.0730, 0.0930");
        }
      }
    }
  }
}
