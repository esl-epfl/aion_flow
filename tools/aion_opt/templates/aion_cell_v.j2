module {{ module_name }} ({% for port in ports %} {{ port.name }}{% if not loop.last %},{% endif %}{% endfor %});

{% for port in ports %}
  {{ port.direction }} {{ port.name }};
  wire {{ port.name }};
{% endfor %}

{% for wire in wires %}
  wire {{ wire }};
{% endfor %}

{% for inst in instances %}
  {{ inst.cell_type }} {{ inst.name }} (
{% for conn in inst.connections %}
    .{{ conn.pin }}({{ conn.net }}){% if not loop.last %},{% endif %}
{% endfor %}
  );
{% endfor %}

endmodule

